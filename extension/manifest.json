{
  "manifest_version": 3,
  "name": "FinSentiment BR",
  "version": "1.0",
  "description": "Financial sentiment analysis for Brazilian Portuguese texts.",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
